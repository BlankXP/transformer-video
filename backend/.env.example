# 复制为 .env 后填写；docker-compose 与本机启动都需要这些变量
#   cp .env.example .env

# 大模型 / 语音识别
DASHSCOPE_API_KEY=your_api_key_here
OPENROUTER_API_KEY=

# 登录凭据（必填，缺失或过弱会拒绝启动）
# 生成方式：openssl rand -base64 24 | tr -d '/+='
AUTH_USERNAME=admin
AUTH_PASSWORD=

# JWT 签名密钥（必填，HS256 至少 32 字节）
# 生成方式：openssl rand -hex 32
JWT_SECRET=

# 令牌有效期（毫秒），上限 7 天
JWT_EXPIRATION=86400000
